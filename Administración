empleados = []
servicios = []



def registrar_empleado():
    print("\n --- REGISTRAR NUEVO EMPLEADO ---")
    nombre = input("Nombre del empleado: ")
    cargo = input("Cargo (costurero, planchador, administrador, etc.): ")
    salario = input("Salario mensual: ")

    empleado = {
        "nombre": nombre,
        "cargo": cargo,
        "salario": salario
    }
    empleados.append(empleado)
    print(" Empleado registrado correctamente.")


def ver_empleados():
    print("\n --- LISTA DE EMPLEADOS ---")
    if not empleados:
        print("No hay empleados registrados.")
    else:
        for i, e in enumerate(empleados, start=1):
            print(f"{i}. {e['nombre']} | Cargo: {e['cargo']} | Salario: ${e['salario']}")


def eliminar_empleado():
    print("\n --- ELIMINAR EMPLEADO ---")
    nombre = input("Ingrese el nombre del empleado a eliminar: ")
    for e in empleados:
        if e["nombre"].lower() == nombre.lower():
            empleados.remove(e)
            print(" Empleado eliminado exitosamente.")
            return
    print(" No se encontró un empleado con ese nombre.")



def registrar_servicio():
    print("\n --- REGISTRAR NUEVO SERVICIO ---")
    nombre = input("Nombre del servicio (arreglo, confección, planchado, etc.): ")
    precio = input("Precio del servicio: ")
    duracion = input("Duración estimada (en horas): ")

    servicio = {
        "nombre": nombre,
        "precio": precio,
        "duracion": duracion
    }
    servicios.append(servicio)
    print(" Servicio registrado correctamente.")


def ver_servicios():
    print("\n --- LISTA DE SERVICIOS ---")
    if not servicios:
        print("No hay servicios registrados.")
    else:
        for i, s in enumerate(servicios, start=1):
            print(f"{i}. {s['nombre']} | Precio: ${s['precio']} | Duración: {s['duracion']} h")


def eliminar_servicio():
    print("\n --- ELIMINAR SERVICIO ---")
    nombre = input("Ingrese el nombre del servicio a eliminar: ")
    for s in servicios:
        if s["nombre"].lower() == nombre.lower():
            servicios.remove(s)
            print(" Servicio eliminado exitosamente.")
            return
    print(" No se encontró un servicio con ese nombre.")



def menu_administracion():
    while True:
        print("\n===== MÓDULO DE ADMINISTRACIÓN - COSTURERÍA =====")
        print("1. Registrar empleado")
        print("2. Ver empleados")
        print("3. Eliminar empleado")
        print("4. Registrar servicio")
        print("5. Ver servicios")
        print("6. Eliminar servicio")
        print("7. Salir")
        opcion = input("Seleccione una opción: ")

        if opcion == "1":
            registrar_empleado()
        elif opcion == "2":
            ver_empleados()
        elif opcion == "3":
            eliminar_empleado()
        elif opcion == "4":
            registrar_servicio()
        elif opcion == "5":
            ver_servicios()
        elif opcion == "6":
            eliminar_servicio()
        elif opcion == "7":
            print(" Saliendo del módulo de administración...")
            break
        else:
            print(" Opción no válida.")




if __name__ == "__main__":
    print(" Bienvenido al sistema de Costurería - Administración")
    menu_administracion()
