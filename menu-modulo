empleados = []
servicios = []
pedidos = []
usuarios = []
pagos = []
usuario_activo = None   # Para manejar el perfil


def crear_perfil():
    print("\n--- CREAR PERFIL ---")
    username = input("Nombre de usuario: ").strip()
    password = input("Contraseña: ").strip()
    rol = input("Rol (administrador / empleado): ").strip()

    usuarios.append({"username": username, "password": password, "rol": rol})
    print("Perfil creado correctamente.")


def escoger_perfil():
    global usuario_activo
    print("\n--- SELECCIONAR PERFIL ---")
    if not usuarios:
        print("No hay perfiles creados. Crea uno primero.")
        return

    for i, u in enumerate(usuarios, start=1):
        print(f"{i}. {u['username']} | Rol: {u['rol']}")

    seleccion = int(input("Seleccione el número del perfil: "))

    if 1 <= seleccion <= len(usuarios):
        usuario_activo = usuarios[seleccion - 1]
        print(f"Perfil iniciado correctamente. Bienvenido {usuario_activo['username']}.")
    else:
        print("Opción inválida.")


def ver_perfil():
    if not usuario_activo:
        print("\nNo hay un perfil seleccionado.")
    else:
        print("\n--- PERFIL ACTIVO ---")
        print(f"Usuario: {usuario_activo['username']}")
        print(f"Rol: {usuario_activo['rol']}")


def cambiar_contraseña():
    global usuario_activo

    if not usuario_activo:
        print("Debe seleccionar un perfil primero.")
        return

    actual = input("Contraseña actual: ")
    if actual != usuario_activo["password"]:
        print("Contraseña incorrecta.")
        return

    nueva = input("Nueva contraseña: ")
    usuario_activo["password"] = nueva
    print("Contraseña actualizada correctamente.")


def menu_perfil_usuario():
    while True:
        print("\n===== PERFIL DE USUARIO =====")
        print("1. Crear perfil")
        print("2. Seleccionar perfil")
        print("3. Ver perfil activo")
        print("4. Cambiar contraseña")
        print("5. Volver al menú principal")
        opcion = input("Seleccione una opción: ")

        if opcion == "1": crear_perfil()
        elif opcion == "2": escoger_perfil()
        elif opcion == "3": ver_perfil()
        elif opcion == "4": cambiar_contraseña()
        elif opcion == "5": break
        else:
            print("Opción no válida.")



def registrar_usuario():
    print("\n--- REGISTRAR NUEVO USUARIO ---")
    username = input("Nombre de usuario: ").strip()
    password = input("Contraseña: ").strip()
    rol = input("Rol (administrador / empleado): ").strip()

    usuarios.append({"username": username, "password": password, "rol": rol})
    print("Usuario registrado correctamente.")


def ver_usuarios():
    print("\n--- LISTA DE USUARIOS ---")
    if not usuarios:
        print("No hay usuarios registrados.")
    else:
        for i, u in enumerate(usuarios, start=1):
            print(f"{i}. Usuario: {u['username']} | Rol: {u['rol']}")


def eliminar_usuario():
    print("\n--- ELIMINAR USUARIO ---")
    username = input("Usuario a eliminar: ").strip()
    for u in usuarios:
        if u["username"] == username:
            usuarios.remove(u)
            print("Usuario eliminado correctamente.")
            return
    print("No se encontró ese usuario.")


def login():
    global usuario_activo
    print("\n--- INICIAR SESIÓN ---")
    username = input("Usuario: ").strip()
    password = input("Contraseña: ").strip()

    for u in usuarios:
        if u["username"] == username and u["password"] == password:
            usuario_activo = u
            print(f"Sesión iniciada correctamente. Bienvenido {username}.")
            return

    print("Usuario o contraseña incorrectos.")


def menu_gestion_usuarios():
    while True:
        print("\n===== MÓDULO DE USUARIOS =====")
        print("1. Registrar usuario")
        print("2. Ver usuarios")
        print("3. Eliminar usuario")
        print("4. Iniciar sesión")
        print("5. Volver al menú principal")
        opcion = input("Seleccione una opción: ")

        if opcion == "1": registrar_usuario()
        elif opcion == "2": ver_usuarios()
        elif opcion == "3": eliminar_usuario()
        elif opcion == "4": login()
        elif opcion == "5": break
        else:
            print("Opción no válida.")




