def registrar_pedido():
    print("\n--- REGISTRAR PEDIDO ---")
    cliente = input("Cliente: ")
    prenda = input("Prenda: ")
    tela = input("Tela: ")
    fecha_registro = input("Fecha de registro: ")
    fecha_entrega = input("Fecha de entrega: ")

    pedidos.append({
        "cliente": cliente,
        "prenda": prenda,
        "tela": tela,
        "fecha_registro": fecha_registro,
        "fecha_entrega": fecha_entrega,
        "estado": "En confección"
    })

    print("Pedido registrado correctamente.")


def ver_pedidos():
    print("\n--- PEDIDOS REGISTRADOS ---")
    if not pedidos:
        print("No hay pedidos registrados.")
    else:
        for i, p in enumerate(pedidos, start=1):
            print(f"{i}. Cliente: {p['cliente']} | Prenda: {p['prenda']} | Estado: {p['estado']}")


def menu_gestion_pedidos():
    while True:
        print("\n===== GESTIÓN DE PEDIDOS =====")
        print("1. Registrar pedido")
        print("2. Ver pedidos")
        print("3. Volver al menú principal")
        opcion = input("Seleccione: ")

        if opcion == "1": registrar_pedido()
        elif opcion == "2": ver_pedidos()
        elif opcion == "3": break
        else: 
            print("Opción no válida.")



def ver_historial_pedidos():
    print("\n===== HISTORIAL COMPLETO DE PEDIDOS =====")
    if not pedidos:
        print("No hay pedidos registrados.")
    else:
        for i, p in enumerate(pedidos, start=1):
            print(f"""
--- Pedido #{i} ---
Cliente: {p['cliente']}
Prenda: {p['prenda']}
Tela: {p['tela']}
Fecha de registro: {p['fecha_registro']}
Fecha de entrega: {p['fecha_entrega']}
Estado: {p['estado']}
""")


def buscar_pedido_cliente():
    print("\n--- BUSCAR POR CLIENTE ---")
    busqueda = input("Nombre del cliente: ").strip()

    encontrados = [p for p in pedidos if p["cliente"].lower() == busqueda.lower()]

    if not encontrados:
        print("No se encontraron pedidos para ese cliente.")
    else:
        for p in encontrados:
            print(f"Cliente: {p['cliente']} | Prenda: {p['prenda']} | Estado: {p['estado']}")


def buscar_pedido_fecha():
    print("\n--- BUSCAR POR FECHA DE REGISTRO ---")
    fecha = input("Ingrese la fecha (Ej: 2025-11-18): ").strip()

    encontrados = [p for p in pedidos if p["fecha_registro"] == fecha]

    if not encontrados:
        print("No hay pedidos en esa fecha.")
    else:
        for p in encontrados:
            print(f"Cliente: {p['cliente']} | Prenda: {p['prenda']} | Entrega: {p['fecha_entrega']}")


def actualizar_estado_pedido():
    print("\n--- ACTUALIZAR ESTADO DEL PEDIDO ---")
    ver_pedidos()

    if not pedidos:
        return

    num = int(input("Número del pedido: "))

    if 1 <= num <= len(pedidos):
        print("Estados disponibles:")
        print("1. En confección")
        print("2. Terminado")
        print("3. Entregado")

        opcion = input("Seleccione el nuevo estado: ")

        if opcion == "1":
            pedidos[num - 1]["estado"] = "En confección"
        elif opcion == "2":
            pedidos[num - 1]["estado"] = "Terminado"
        elif opcion == "3":
            pedidos[num - 1]["estado"] = "Entregado"
        else:
            print("Estado no válido.")
            return

        print("Estado actualizado correctamente.")
    else:
        print("Número de pedido inválido.")


def eliminar_pedido():
    print("\n--- ELIMINAR PEDIDO ---")
    ver_pedidos()

    if not pedidos:
        return

    num = int(input("Número del pedido a eliminar: "))

    if 1 <= num <= len(pedidos):
        pedidos.pop(num - 1)
        print("Pedido eliminado correctamente.")
    else:
        print("Número inválido.")


